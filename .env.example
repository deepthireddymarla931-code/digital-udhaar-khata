# DIGITAL UDHAAR KHATA - ENVIRONMENT CONFIGURATION TEMPLATE
PORT=8080
NODE_ENV=development

# For Aiven Cloud MySQL:
# DB_HOST=mysql-179402c5-digitaludharkhata.i.aivencloud.com
# DB_PORT=13167
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_SSL=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=udhaar_db
DB_USER=root
DB_PASSWORD=root
DB_SSL=false

# JWT AUTHENTICATION
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AUTOMATED DUE-DATE REMINDERS & SMS DISPATCHER
# Provider options: SIMULATED (default for testing/console log) | TWILIO | FAST2SMS | WHATSAPP
SMS_PROVIDER=SIMULATED

# Twilio Configuration (Optional - Required if SMS_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Fast2SMS Configuration (Optional - Required if SMS_PROVIDER=FAST2SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key

# WhatsApp Cloud API (Optional - Required if SMS_PROVIDER=WHATSAPP)
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# AI CAPABILITIES (OpenAI / Gemini REST Fallback)
AI_API_KEY=mock_key
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-3.5-turbo

# FRONTEND WEBSOCKET & API URL (for Vite)
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=http://localhost:8080
